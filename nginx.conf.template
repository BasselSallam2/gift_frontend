server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    # Compose default 127.0.0.11; Kubernetes/host networks: set NGINX_RESOLVER (e.g. 10.152.152.10)
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    gzip on;
    gzip_types text/css application/javascript application/json;

    # Must come before "/" — POST → Express (otherwise try_files falls back to index.html → 405)
    location ^~ /api {
        set $gift_upstream "${GIFTS_BACKEND_ORIGIN}$request_uri";
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass $gift_upstream;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location = /js/config.js {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri /index.html;
    }

    location ~* \.(css|js)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}
